{
  "version": "1.3",
  "name": "DocumentLifecycleWorkflow",
  "desc": "Workflow derived from the supplied diagram: new -> active -> approved -> archived, with externalized processors covering validation, notification, and COMMIT_BEFORE_DISPATCH editing paths.",
  "initialState": "new",
  "active": true,
  "states": {
    "new": {
      "transitions": [
        {
          "name": "to_active",
          "next": "active",
          "manual": false,
          "disabled": false,
          "annotations": {
            "displayName": "Activate document",
            "description": "Validates a freshly submitted document and notifies the author once it goes live."
          },
          "criterion": {
            "type": "simple",
            "jsonPath": "$.submitted",
            "operation": "EQUALS",
            "value": true
          },
          "criterionAnnotations": {
            "displayName": "Submitted for review",
            "description": "Fires once the author marks the document as submitted."
          },
          "processors": [
            {
              "type": "externalized",
              "name": "validate",
              "executionMode": "SYNC",
              "annotations": {
                "displayName": "Validate document",
                "description": "Schema and business-rule checks before the document is activated."
              },
              "config": {
                "attachEntity": true
              }
            },
            {
              "type": "externalized",
              "name": "notify_created",
              "annotations": {
                "displayName": "Creation notice",
                "description": "Emails the author that their document is now active."
              },
              "config": {
                "calculationNodesTags": "notifications"
              }
            }
          ]
        }
      ]
    },
    "active": {
      "transitions": [
        {
          "name": "to_approved",
          "next": "approved",
          "manual": true,
          "disabled": false,
          "annotations": {
            "displayName": "Approve",
            "description": "Manager sign-off; sends the customer approval notification."
          },
          "processors": [
            {
              "type": "externalized",
              "name": "notify",
              "executionMode": "COMMIT_BEFORE_DISPATCH",
              "annotations": {
                "displayName": "Approval notice",
                "description": "Notifies the customer channel after the approval commits."
              },
              "config": {
                "attachEntity": true,
                "calculationNodesTags": "notifications,customer",
                "context": "channel=email",
                "startNewTxOnDispatch": true
              }
            }
          ]
        }
      ]
    },
    "approved": {
      "transitions": [
        {
          "name": "to_archived",
          "next": "archived",
          "manual": false,
          "disabled": false,
          "annotations": {
            "displayName": "Auto-archive",
            "description": "Archives documents created before the cutoff date. cyoda-go's lifecycle criterion compares against a literal timestamp only (no relative \"N days ago\" operand), so a real rolling window needs a scheduled recompute of this value rather than a static one."
          },
          "criterion": {
            "type": "lifecycle",
            "field": "creationDate",
            "operation": "LESS_OR_EQUAL",
            "value": "2026-01-01T00:00:00Z"
          },
          "criterionAnnotations": {
            "displayName": "Created before cutoff",
            "description": "Lifecycle guard on the document's creation date."
          }
        },
        {
          "name": "auto_archive",
          "next": "archived",
          "manual": false,
          "disabled": false
        }
      ]
    },
    "archived": {
      "transitions": [
        {
          "name": "reactivate",
          "next": "active",
          "manual": true,
          "disabled": false
        }
      ]
    }
  }
}
